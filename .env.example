# Koristi se za docker-compose.yml (Postgres) i za backend/.env
POSTGRES_PASSWORD=change-me-in-production

# Backend (backend/.env)
DATABASE_URL=postgresql+psycopg://crm_user:crm_password@localhost:5432/crm_online_marketing
APP_ENV=development
SECRET_KEY=change-me-to-a-long-random-value-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080
GOOGLE_CLIENT_ID=
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
